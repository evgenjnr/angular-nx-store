{
  "name": "@angular-nx-store/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "start:e-store": "nx serve e-store --port 4201 -o",
    "start:admin": "nx serve admin --port 4202 -o",
    "start:api:dev": "nx serve api --configuration=development --skip-nx-cache",
    "start:db": "cd ./apps/backend/api && docker compose --env-file .env up -d",
    "stop:db": "cd ./apps/backend/api &&  docker-compose stop",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "typeorm:run-migrations": "yarn run typeorm migration:run -d ./apps/backend/api/typeOrm.config.ts",
    "typeorm:generate-migration": "yarn run typeorm -- -d ./apps/backend/api/typeorm.config.ts migration:generate ./apps/backend/api/migrations/${0} --verbose",
    "typeorm:create-migration": "yarn run typeorm migration:create ./apps/backend/api/migrations/${0}",
    "typeorm:revert-migration": "yarn run typeorm -- -d ./apps/backend/api/typeorm.config.ts migration:revert"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~18.2.0",
    "@angular/common": "~18.2.0",
    "@angular/compiler": "~18.2.0",
